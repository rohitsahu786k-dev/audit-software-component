PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?appName=Cluster0
MONGODB_DB=onepws_audit

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.gmail@domain.com
SMTP_PASS="your gmail app password"
SMTP_FROM="ONEPWS AuditPro <your.gmail@domain.com>"

# ── AUTOMATIC CAPA REMINDERS ──
# Server-side cron: reminders fire even when nobody has the portal open.
# Set EMAIL_AUTOMATION=false to disable all automatic sending (manual/test emails still work).
EMAIL_AUTOMATION=true
EMAIL_CRON=0 9 * * *
EMAIL_CRON_TZ=Asia/Kolkata
# How many days before the due date the "Upcoming Target Closure Reminder" starts going out.
EMAIL_REMINDER_WINDOW_DAYS=2

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or use:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
